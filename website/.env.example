# 共享反馈的云端配置（构建期写入静态产物，更改后必须重新构建）。
#
# 这两项都是公开值：endpoint 是本应用的数据面地址，publishableKey 只用于标识
# 应用，本身不带数据权限——服务端另有来源校验，数据库另有行级权限与函数权限。
# 数据库连接串、任何服务器密钥都不得写在这里，也不会进入网页代码。
#
# 留空表示「共享反馈尚未开放」：网站仍可浏览，但不会提交或读取反馈。
#
# 旧的自建 HTTP 接口配置（现已不用）：若仍填写下面两项，则优先使用自建接口。
NEXT_PUBLIC_WORKBUDDY_CLOUD_ENDPOINT=
NEXT_PUBLIC_WORKBUDDY_CLOUD_KEY=

NEXT_PUBLIC_FEEDBACK_API_BASE_URL=
NEXT_PUBLIC_FEEDBACK_SERVICE_VERIFIED=false
