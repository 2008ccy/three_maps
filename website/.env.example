# Public HTTPS base URL only. Never place database credentials here.
# The WorkBuddy backend may use PostgreSQL or the legacy document database;
# the website uses the same HTTP contract for both modes.
# Supply the gateway BASE URL, without the /feedback suffix. Example:
# https://api.example.com/v1 (requests go to /v1/feedback).
# Keep empty until WorkBuddy database, HTTP functions and protected management
# access have passed the deployment checklist in feedback-cloud/README.md.
# These values are embedded at BUILD TIME: rebuild and redeploy after changing
# them. For GitHub Pages, set the same names under repository Settings > Secrets
# and variables > Actions > Variables; the workflow passes them to the build.
NEXT_PUBLIC_FEEDBACK_API_BASE_URL=
NEXT_PUBLIC_FEEDBACK_SERVICE_VERIFIED=false
