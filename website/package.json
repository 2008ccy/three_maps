{
  "name": "three-maps-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack && node scripts/write-build-info.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "start": "node scripts/preview.mjs",
    "types:check": "next typegen && tsc --noEmit",
    "preview": "node scripts/preview.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check": "npm run check:content && npm run types:check",
    "test": "node --test scripts/test-static.mjs scripts/test-maps.mjs"
  },
  "dependencies": {
    "cn": "0.5.0",
    "flexsearch": "0.8.212",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "gray-matter": "4.0.3",
    "katex": "0.19.1",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/flexsearch": "0.7.6",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "katex": "$katex"
  }
}
