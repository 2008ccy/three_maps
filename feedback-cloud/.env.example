# Server-side configuration only. These placeholders do not enable the service.
FEEDBACK_ENV_ID=
FEEDBACK_DATABASE_MODE=
# document: existing CloudBase document database; postgres: existing WorkBuddy PG.
# Server-only login, NEVER a browser/anon/authenticated key. No URL query options.
FEEDBACK_POSTGRES_URL=
# Optional PEM root CA; certificate verification stays enabled.
FEEDBACK_POSTGRES_CA=
FEEDBACK_ALLOWED_ORIGINS=[]
FEEDBACK_HASH_SECRET=
FEEDBACK_MANAGEMENT_VERIFIED=false
FEEDBACK_GATEWAY_VERIFIED=false
